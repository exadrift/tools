NAME := $(shell basename $${PWD})
GO_VERSION := 1.26
LINTER_VERSION := 2.12.2
VERSION ?= local
GO_IMAGE := golang:$(GO_VERSION)-alpine
HOME=$(shell echo $$HOME)
MOUNT ?=
DOCKER_CMD := docker run --network host --rm -e GOCACHE=/tmp/go-build -e CGO_ENABLED=0 -e HOME=$$HOME -v $$HOME:$$HOME -v $(shell pwd):/build -v $(HOME)/tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock $(MOUNT) -w /build
USERID := $(shell id -u)
GROUPID := $(shell id -g)
DOCKER_CMD_USER := $(DOCKER_CMD) -u $(USERID):$(GROUPID)
PRE_BUILD_ARGS := $(GO_IMAGE)
BUILD_ARGS := $(PRE_BUILD_ARGS) go build -trimpath -ldflags="-s -w -X 'main.Version=$(VERSION)'" -mod=mod
GO_RUN_ROOT := $(DOCKER_CMD) $(GO_IMAGE) go
GO_FILES := $(shell find . -type f -path **/*.go -not -path "./vendor/*")
OS ?= $(shell uname -s | tr '[:upper:]' '[:lower:]')
ARCH ?= $(shell uname -m | sed 's/x86_64/amd64/')
IMAGE_NAME := exadrift/$(NAME)
IMAGE_TAG := $(IMAGE_NAME):$(VERSION)

$(HOME)/tmp:
	mkdir -p $(HOME)/tmp
	chmod 777 $(HOME)/tmp

.PHONY: build-test-containers
build-test-containers:
	../build-test-containers

.PHONY: go-shell
go-shell: $(HOME)/tmp
	$(DOCKER_CMD_USER) -it $(GO_IMAGE) sh

.PHONY: tidy
tidy: $(HOME)/tmp
	$(DOCKER_CMD_USER) $(PRE_BUILD_ARGS) go mod tidy

vendor: $(HOME)/tmp
	$(DOCKER_CMD_USER) $(PRE_BUILD_ARGS) go mod vendor

.PHONY: test
test: build-test-containers
	# tests are run as root for docker socket access within the container
	$(GO_RUN_ROOT) test -cover -p 1 --timeout 10m ./...

.PHONY: lint-check
lint-check:
	docker run -t --rm -v $(shell pwd):/app -w /app golangci/golangci-lint:v$(LINTER_VERSION) golangci-lint run

.PHONY: build
build: build-docker

.PHONY: build-docker
build-docker: build-bins
	docker build --build-arg NAME=$(NAME) -t $(IMAGE_TAG) .

.PHONY: publish
publish: build-docker
	docker push $(IMAGE_TAG)

.PHONY: build-bins
build-bins:
	# build all supported os/architectures
	OS=linux ARCH=amd64 make -f ../Makefile-go build-one
	if [ ! -f .linuxonly ]; then OS=darwin ARCH=amd64 make -f ../Makefile-go build-one; fi
	if [ ! -f .linuxonly ]; then OS=darwin ARCH=arm64 make -f ../Makefile-go build-one; fi

.PHONY: build-one
build-one: bin/$(NAME)-$(OS)-$(ARCH)

bin/$(NAME)-$(OS)-$(ARCH): $(HOME)/tmp
	$(DOCKER_CMD_USER) ls -la /tmp
	$(DOCKER_CMD_USER) -e GOOS=$(OS) -e GOARCH=$(ARCH) $(BUILD_ARGS) -o ./bin/$(NAME)-$(OS)-$(ARCH) *.go

.PHONY: install
install: build-one
	cp ./bin/$(NAME)-$(OS)-$(ARCH) /usr/local/bin/

.PHONY: run
run: build-one
	./bin/$(NAME)-$(OS)-$(ARCH)

.PHONY: clean
clean:
	rm -rf bin
